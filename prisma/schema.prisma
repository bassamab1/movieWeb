generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}




//////////////////////////////////////////////////////
// USER MODEL
//////////////////////////////////////////////////////
model User {
  id        String           @id @default(cuid())
  name      String
  email     String           @unique
  password  String
  role      String   @default("user")

  // Relations
  watchlist WatchlistItem[]

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

//////////////////////////////////////////////////////
// MOVIE MODEL
//////////////////////////////////////////////////////
model Movie {
  id          String           @id @default(cuid())
  title       String
  description String?
  year        Int?

  // Relations
  watchlist   WatchlistItem[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

//////////////////////////////////////////////////////
// WATCHLIST (JOIN TABLE WITH EXTRA DATA)
//////////////////////////////////////////////////////
model WatchlistItem {
  id        String        @id @default(cuid())

  status    WatchStatus   @default(PLANNED)

  // Foreign Keys
  userId    String
  movieId   String

  // Relations
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Prevent duplicate movie per user
  @@unique([userId, movieId])
}

//////////////////////////////////////////////////////
// ENUM FOR STATUS
//////////////////////////////////////////////////////
enum WatchStatus {
  PLANNED
  WATCHING
  COMPLETED
  DROPPED
}